{
  "name": "automated-quality-gate",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "jest --coverage",
    "test:angularjs": "node --test tests/angularjs.cjs tests/reporting.cjs",
    "test:ai": "node --test tests/ai.cjs",
    "test:pipeline": "node --test tests/pipeline.cjs",
    "test:sonar": "node --test tests/sonar.cjs",
    "test:setup": "npm ci --prefix lib/angularjs/tooling --ignore-scripts --no-audit --no-fund && npm ci --prefix tests/fixtures/angularjs --ignore-scripts --no-audit --no-fund",
    "gate": "node generate-tests.js",
    "build": "ncc build generate-tests.js -o dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@vercel/ncc": "^0.45.0",
    "jest": "^30.2.0"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.4.2"
  }
}
